# Local Database and PHP servers (binary folders)
mariadb/
php/
mailpit/
scratch/

# Playwright MCP debug artifacts (page snapshots, console logs)
.playwright-mcp/

# Environments and Secrets
.env

# SQL Files (Ignore large database dumps but keep project schemas)
import/
*.sql
!sql/civicrm_mock.sql

# Composer files
vendor/
composer.lock
composer.phar


# Windows OS metadata
Thumbs.db
ehthumbs.db
Desktop.ini
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# Local Caddy files
caddy.exe
Caddyfile
start-proxy.bat

# Server-side runtime logs
*.log
error_log

# .htaccess used to be ignored wholesale, because the only ones in play were
# host-specific Basic Auth gates gating pre-launch deployments. Those are gone
# as of 2026-07-28, and the ones that remain are portable app config that has to
# ship with the code -- so they are tracked now. Keep host-specific paths and
# credentials out of them; .htpasswd files stay untracked below.
.htpasswd
*.bak

